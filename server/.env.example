# Copy to .env and adjust. These are placeholders, never commit real secrets.
# Pooled Neon string (host contains -pooler): used by the running API.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct Neon string (no -pooler): used by migrate and seed.
DIRECT_URL=postgres://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PORT=4000
# The API's public address, used in photo links (production). Empty: the request's own address.
PUBLIC_API_URL=
