# Copy to .env.local only for a production-like build.
# Development needs nothing: Vite forwards /api to the local API on port 4000.
# Production: the deployed API address (the app calls $VITE_API_URL/api/...).
VITE_API_URL=
# 1 = use the in-memory mock API instead of a server (unit tests and the UI e2e suite set this).
VITE_API_MOCK=
